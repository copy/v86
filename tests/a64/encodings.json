    { "group": "Branches, Exception Generating and System", "class": "Conditional branch (immediate)", "status": "implemented", "instructions": ["b.cond"], "notes": "BC.cond (FEAT_HBC) is undef", "tests": ["decode_check", "integer_oracle"] },
    { "group": "Branches, Exception Generating and System", "class": "Exception generation", "status": "implemented", "instructions": ["svc", "hvc", "brk", "hlt"], "exceptions": "SVC EC 0x15; HVC is PSCI/SMCCC (P4.4); SMC undef (no EL3); BRK EC 0x3C; HLT, DCPS1-3 undef outside Debug state; TCANCEL undef (FEAT_TME)", "tests": ["decode_check", "platform_probe"] },
    { "group": "Branches, Exception Generating and System", "class": "System instructions with register argument", "status": "undef", "feature": "FEAT_WFxT", "tests": ["decode_check"] },
