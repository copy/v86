    { "group": "Branches, Exception Generating and System", "class": "Barriers", "status": "implemented", "instructions": ["clrex", "dsb", "dmb", "isb"], "notes": "every CRm is a full barrier; SB (FEAT_SB), DSB nXS (FEAT_XS), TCOMMIT (FEAT_TME) undef", "tests": ["decode_check"] },
