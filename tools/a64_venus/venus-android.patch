+
+#if DETECT_OS_ANDROID
+/* Android's SELinux policy lets apps and SurfaceFlinger open the render node
+ * (gralloc opens it in every process) but not list /dev/dri or read the
+ * device's sysfs, which drmGetDevices2 needs: open the render nodes by path
+ * and keep the one virtio_gpu drives.
+ */
+static VkResult
+virtgpu_open_render_node_paths(struct virtgpu *gpu)
+{
+   for (int n = 128; n < 136; n++) {
+      char path[32];
+      snprintf(path, sizeof(path), "/dev/dri/renderD%d", n);
+      int fd = open(path, O_RDWR | O_CLOEXEC);
+      if (fd < 0)
+         continue;
+
+      drmVersionPtr version = drmGetVersion(fd);
+      const bool ok = version && !strcmp(version->name, "virtio_gpu") &&
+                      version->version_major == 0;
+      if (version)
+         drmFreeVersion(version);
+      if (!ok) {
+         close(fd);
+         continue;
+      }
+
+      gpu->fd = fd;
+
+      char primary_path[32];
+      struct stat st;
+      snprintf(primary_path, sizeof(primary_path), "/dev/dri/card%d", n - 128);
+      if (stat(primary_path, &st) == 0) {
+         gpu->has_primary = true;
+         gpu->primary_major = major(st.st_rdev);
+         gpu->primary_minor = minor(st.st_rdev);
+      } else {
+         gpu->has_primary = false;
+         gpu->primary_major = 0;
+         gpu->primary_minor = 0;
+      }
+      fstat(fd, &st);
+      gpu->render_major = major(st.st_rdev);
+      gpu->render_minor = minor(st.st_rdev);
+      gpu->bustype = DRM_BUS_PLATFORM;
+
+      if (VN_DEBUG(INIT))
+         vn_log(gpu->instance, "using DRM device %s (opened by path)", path);
+      return VK_SUCCESS;
+   }
+
+   return VK_ERROR_INITIALIZATION_FAILED;
 }
+#endif
 
 static VkResult
 virtgpu_open(struct virtgpu *gpu)
