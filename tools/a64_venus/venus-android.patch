--- /dev/null
+++ b/src/util/u_gralloc/u_gralloc_minigbm.c
@@ -0,0 +1,102 @@
+/*
+ * Mesa 3-D graphics library
+ *
+ * SPDX-License-Identifier: MIT
+ */
+
+/* minigbm's buffer handles read directly: gralloc on a device whose minigbm
+ * has only the AIDL allocator and IMapper5 (Cuttlefish), with no gralloc0
+ * module for the CrOS API and no libui for IMapper. The handle is minigbm's
+ * cros_gralloc_handle (external/minigbm/cros_gralloc/cros_gralloc_handle.h),
+ * a packed structure after native_handle_t, recognised by its magic. The
+ * layout is Android 16's (Cuttlefish build 15581820), as an AHardwareBuffer's
+ * handle showed it: 2 fds (the planes', the reserved region's), 34 ints.
+ */
+
+#include <errno.h>
+#include <stdint.h>
+#include <string.h>
+
+#include "drm-uapi/drm_fourcc.h"
+#include "util/log.h"
+#include "util/u_memory.h"
+
+#include "u_gralloc_internal.h"
+
+#define MINIGBM_MAX_PLANES 4
+#define MINIGBM_MAX_FDS (MINIGBM_MAX_PLANES + 1)
+#define MINIGBM_MAGIC 0xABCDDCBA
+
+struct minigbm_handle {
+   native_handle_t base;
+   int32_t fds[MINIGBM_MAX_FDS];
+   uint32_t strides[MINIGBM_MAX_PLANES];
+   uint32_t offsets[MINIGBM_MAX_PLANES];
+   uint32_t sizes[MINIGBM_MAX_PLANES];
+   uint32_t id;
+   uint32_t width;
+   uint32_t height;
+   uint32_t format; /* DRM fourcc */
+   uint32_t tiling;
+   uint64_t format_modifier;
+   uint64_t use_flags;
+   uint32_t magic;
+   uint32_t pixel_stride;
+   int32_t droid_format;
+   uint64_t usage; /* Android's */
+   uint32_t num_planes;
+   uint64_t reserved_region_size;
+   uint64_t total_size;
+} __attribute__((packed));
+
+static const struct minigbm_handle *
+minigbm_handle_of(const native_handle_t *handle)
+{
+   const size_t words = (sizeof(struct minigbm_handle) - sizeof(native_handle_t)) / sizeof(int);
+   if (!handle || handle->numFds < 1 || (size_t)(handle->numFds + handle->numInts) < words)
+      return NULL;
+   const struct minigbm_handle *h = (const struct minigbm_handle *)handle;
+   if (h->magic != MINIGBM_MAGIC || h->num_planes < 1 || h->num_planes > MINIGBM_MAX_PLANES)
+      return NULL;
+   return h;
+}
+
+static int
+minigbm_get_buffer_info(struct u_gralloc *gralloc,
+                        struct u_gralloc_buffer_handle *hnd,
+                        struct u_gralloc_buffer_basic_info *out)
+{
+   const struct minigbm_handle *h = minigbm_handle_of(hnd->handle);
+   if (!h)
+      return -EINVAL;
+
+   out->drm_fourcc = h->format;
+   out->modifier = h->format_modifier == DRM_FORMAT_MOD_INVALID ? DRM_FORMAT_MOD_LINEAR : h->format_modifier;
+   out->num_planes = h->num_planes;
+   for (uint32_t i = 0; i < h->num_planes; i++) {
+      /* (planes may share one buffer: minigbm packs the descriptors it has) */
+      out->fds[i] = (int)i < h->base.numFds ? h->fds[i] : h->fds[0];
+      out->offsets[i] = h->offsets[i];
+      out->strides[i] = h->strides[i];
+   }
+   return 0;
+}
+
+static int
+minigbm_destroy(struct u_gralloc *gralloc)
+{
+   FREE(gralloc);
+   return 0;
+}
+
+struct u_gralloc *
+u_gralloc_minigbm_create(void)
+{
+   struct u_gralloc *gralloc = CALLOC_STRUCT(u_gralloc);
+   if (!gralloc)
+      return NULL;
+   gralloc->ops.get_buffer_basic_info = minigbm_get_buffer_info;
+   gralloc->ops.destroy = minigbm_destroy;
+   mesa_logi("Using minigbm's handles directly");
+   return gralloc;
+}
